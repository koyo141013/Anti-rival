		end)

		noRecoilButton.MouseButton1Click:Connect(function()
			env._rivNoRecoil = not env._rivNoRecoil
			setToggle(noRecoilButton, env._rivNoRecoil, "No Recoil / No Spread")
		end)

		espButton.MouseButton1Click:Connect(function() if toggleEsp then toggleEsp(not S.espOn) end end)
		namesButton.MouseButton1Click:Connect(function() S.namesOn = not S.namesOn; setToggle(namesButton, S.namesOn, "player names") end)
		healthButton.MouseButton1Click:Connect(function() S.healthOn = not S.healthOn; setToggle(healthButton, S.healthOn, "player health text") end)

		infiniteJumpButton.MouseButton1Click:Connect(function() S.infiniteJumpOn = not S.infiniteJumpOn; setToggle(infiniteJumpButton, S.infiniteJumpOn, "infinite jump") end)

		orbitButton.MouseButton1Click:Connect(function()
			S.orbitOn = not S.orbitOn
			if S.orbitOn then S.voidSpanOn = false; setToggle(voidSpanButton, false, "void span mode") end
			setToggle(orbitButton, S.orbitOn, "orbit position mode")
		end)

		voidSpanButton.MouseButton1Click:Connect(function()
			S.voidSpanOn = not S.voidSpanOn
			if S.voidSpanOn then S.orbitOn = false; setToggle(orbitButton, false, "orbit position mode") end
			setToggle(voidSpanButton, S.voidSpanOn, "void span mode")
		end)

		teleporterButton.MouseButton1Click:Connect(function() S.teleporterOn = not S.teleporterOn; setToggle(teleporterButton, S.teleporterOn, "auto 50k tp (every 1s)") end)
		noclipButton.MouseButton1Click:Connect(function() if toggleNoclip then toggleNoclip(not S.noclipOn) end end)

		showPage("main")
		print("Anti-rival beta v0.1.17 Enhanced & Loaded Successfully! (Silent Aim v4 + FOV/Target/HitPart + Triggerbot)")
	end)
end

