	local keyBox = Instance.new("TextBox")
	keyBox.Size = UDim2.fromOffset(316, 28)
	keyBox.Position = UDim2.fromOffset(12, 84)
	keyBox.BackgroundColor3 = Color3.fromRGB(22, 22, 26)
	keyBox.BorderColor3 = Color3.fromRGB(45, 45, 60)
	keyBox.BorderSizePixel = 1
	keyBox.PlaceholderText = "Enter your key here..."
	keyBox.Text = ""
	keyBox.TextColor3 = Color3.new(1, 1, 1)
	keyBox.TextSize, keyBox.Font = 11, Enum.Font.Code
	keyBox.Parent = keyFrame

	local submitBtn = Instance.new("TextButton")
	submitBtn.Size = UDim2.fromOffset(316, 30)
	submitBtn.Position = UDim2.fromOffset(12, 124)
	submitBtn.BackgroundColor3 = Color3.fromRGB(25, 55, 40)
	submitBtn.BorderColor3 = Color3.fromRGB(45, 95, 65)
	submitBtn.BorderSizePixel = 1
	submitBtn.Text = "Submit Key"
	submitBtn.TextColor3 = Color3.fromRGB(100, 180, 255)
	submitBtn.TextSize, submitBtn.Font = 12, Enum.Font.Code
	submitBtn.Parent = keyFrame

	submitBtn.MouseButton1Click:Connect(function()
		if keyBox.Text == CORRECT_KEY then
			saveVerifiedKey(keyBox.Text)
			if cursorConnection then cursorConnection:Disconnect() end
			keyGui:Destroy()
			initMainScript()
		else
			submitBtn.Text = "Incorrect Key!"
			submitBtn.BackgroundColor3 = Color3.fromRGB(90, 30, 30)
			task.delay(1.5, function()
				if submitBtn and submitBtn.Parent then submitBtn.Text = "Submit Key"; submitBtn.BackgroundColor3 = Color3.fromRGB(25, 55, 40) end
			end)
		end
	end)
