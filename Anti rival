	local function executeFight(state)
		fightOn = state
		setToggle(fightButton, fightOn, "fight mode")
		if isMobile then
			fightControlGui.Enabled = fightOn
		end
		
		local hum, root = getSafeParts()

		if fightOn then
			if not root or not hum then
				fightOn = false
				setToggle(fightButton, false, "fight mode")
				if isMobile then fightControlGui.Enabled = false end
				return
			end

			bodyGyro = Instance.new("BodyGyro")
			bodyGyro.P = 9e4
			bodyGyro.MaxTorque = Vector3.new(9e4, 9e4, 9e4)
			bodyGyro.CFrame = root.CFrame
			bodyGyro.Parent = root

			bodyVelocity = Instance.new("BodyVelocity")
			bodyVelocity.Velocity = Vector3.zero
			bodyVelocity.MaxForce = Vector3.new(9e4, 9e4, 9e4)
			bodyVelocity.Parent = root

			hum.PlatformStand = true

			fightConnection = RunService.RenderStepped:Connect(function()
				local currentCam = getActiveCamera()
				local currentHum, currentRoot = getSafeParts()
				if not fightOn or not currentRoot or not currentHum or currentHum.Health <= 0 then
					if toggleFight then toggleFight(false) end
					return
				end

				if bodyGyro then bodyGyro.CFrame = currentCam.CFrame end
				local moveDir = Vector3.zero
				
				if isMobile then
					if currentHum.MoveDirection.Magnitude > 0 then
						moveDir = currentHum.MoveDirection.Unit * fightSpeed
					end
					if fightUpActive then
						moveDir = moveDir + Vector3.new(0, fightSpeed, 0)
					elseif fightDownActive then
						moveDir = moveDir - Vector3.new(0, fightSpeed, 0)
					end
				else
					if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + currentCam.CFrame.LookVector end
					if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - currentCam.CFrame.LookVector end
					if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - currentCam.CFrame.RightVector end
					if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + currentCam.CFrame.RightVector end
					if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir = moveDir + Vector3.new(0, 1, 0) end
					if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
						moveDir = moveDir - Vector3.new(0, 1, 0)
					end
				end

				if bodyVelocity then
					if isMobile then
						if moveDir.Magnitude > 0 then
							bodyVelocity.Velocity = moveDir
						else
							bodyVelocity.Velocity = Vector3.zero
						end
					else
						if moveDir.Magnitude > 0 then
							bodyVelocity.Velocity = moveDir.Unit * fightSpeed
						else
							bodyVelocity.Velocity = Vector3.zero
						end
					end
				end
			end)
			trackConn(fightConnection)
		else
			if fightConnection then
				pcall(function() fightConnection:Disconnect() end)
				fightConnection = nil
			end
			if bodyGyro then bodyGyro:Destroy() bodyGyro = nil end
			if bodyVelocity then bodyVelocity:Destroy() bodyVelocity = nil end

			if hum then
				hum.PlatformStand = false
			end
		end
	end

