				if p ~= player then
					local char = p.Character
					if char then
						local hum = char:FindFirstChildOfClass("Humanoid")
						local targetRoot = char:FindFirstChild("HumanoidRootPart")
						if hum and hum.Health > 0 and targetRoot then
							local dist = (targetRoot.Position - root.Position).Magnitude
							if dist <= 45 then
								pcall(function()
									for _, tool in ipairs(player.Character:GetChildren()) do
										if tool:IsA("Tool") then tool:Activate() end
									end
								end)
							end
						end
					end
				end
			end
		end)
	end))

	trackConn(RunService.RenderStepped:Connect(function()
		if not triggerBotOn then return end
		pcall(function()
			local currentCam = getActiveCamera()
			local mouseLocation = UserInputService:GetMouseLocation()
			local unitRay = currentCam:ScreenPointToRay(mouseLocation.X, mouseLocation.Y)
			
			local raycastParams = RaycastParams.new()
			raycastParams.FilterType = RaycastType.Include
			local includeList = {}
			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= player and p.Character then
					table.insert(includeList, p.Character)
				end
			end
			raycastParams.FilterDescendantsInstances = includeList
			raycastParams.IgnoreWater = true
			
			local raycastResult = Workspace:Raycast(unitRay.Origin, unitRay.Direction * 10000, raycastParams)
			if raycastResult and raycastResult.Instance then
				local hitChar = raycastResult.Instance.Parent
				local hum = hitChar:FindFirstChildOfClass("Humanoid")
				local p = Players:GetPlayerFromCharacter(hitChar)
				if hum and hum.Health > 0 and p and p ~= player then
					pcall(function()
						for _, tool in ipairs(player.Character:GetChildren()) do
							if tool:IsA("Tool") then
								tool:Activate()
							end
						end
					end)
				end
			end
		end)
	end))

	trackConn(RunService.RenderStepped:Connect(function()
		if forceThirdPersonOn then
			pcall(function()
				player.CameraMode = Enum.CameraMode.Classic
				if player.CameraMinZoomDistance < 10 then
					player.CameraMinZoomDistance = 10
				end
				if player.CameraMaxZoomDistance < 10 then
					player.CameraMaxZoomDistance = 100
				end
				local currentCam = getActiveCamera()
				if currentCam then
					if currentCam.CameraType == Enum.CameraType.Scriptable then
						currentCam.CameraType = Enum.CameraType.Custom
					end
					local isAiming = false
					local char = player.Character
					if char then
						for _, tool in ipairs(char:GetChildren()) do
							if tool:IsA("Tool") then
								local aimingValue = tool:FindFirstChild("Aiming") or tool:FindFirstChild("IsAiming") or tool:FindFirstChild("Zoom")
								if aimingValue then
									if typeof(aimingValue) == "BoolValue" and aimingValue.Value == true then
										isAiming = true
									elseif typeof(aimingValue) == "NumberValue" and aimingValue.Value > 0 then
										isAiming = true
									end
								end
							end
						end
					end

					if not isAiming then
						local head = char and (char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart"))
						if head and (currentCam.Focus.Position - head.Position).Magnitude > 50 then
							currentCam.CFrame = CFrame.new(head.Position + Vector3.new(0, 5, -12), head.Position)
						end
					end
				end
			end)
		end
	end))

