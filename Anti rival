			end

			local highlight = espCache[p] and espCache[p].Highlight
			if S.espOn then
				if not highlight or not highlight.Parent then
					highlight = Instance.new("Highlight")
					highlight.Name = "AntiRivalESP"
					highlight.Adornee = char
					highlight.FillColor = Color3.fromRGB(255, 50, 50)
					highlight.FillTransparency = 0.5
					highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
					highlight.Parent = char
				else
					highlight.Adornee = char
				end
			else
				if highlight then highlight:Destroy(); highlight = nil end
			end

			local head = char:FindFirstChild("Head")
			local infoBillboard = espCache[p] and espCache[p].InfoBillboard

			if (S.namesOn or S.healthOn) and head then
				if not infoBillboard or not infoBillboard.Parent then
