					local currentCam = getActiveCamera()
					if currentCam and currentCam.CameraType == Enum.CameraType.Scriptable then
						currentCam.CameraType = Enum.CameraType.Custom
					end
				end)
			end
		end))

		trackConn(RunService.RenderStepped:Connect(function()
			if S.orbitOn then
				pcall(function()
					local _, root = getSafeParts()
					if root then
						local t = os.clock() * 5
						root.CFrame = CFrame.new(root.Position + Vector3.new(math.cos(t) * 25, 10, math.sin(t) * 25))
					end
				end)
			elseif S.voidSpanOn then
				pcall(function()
					local _, root = getSafeParts()
					if root then root.CFrame = CFrame.new(root.Position + Vector3.new(0, 500, 0)) end
				end)
			end
		end))

		trackConn(RunService.RenderStepped:Connect(function()
			if not S.teleporterOn then return end
			local now = os.clock()
			if now - S.lastTeleportTick >= 1.0 then
				S.lastTeleportTick = now
				pcall(function()
					local _, root = getSafeParts()
					if root then
						local randomAngle = math.random() * math.pi * 2
						root.CFrame = CFrame.new(root.Position + Vector3.new(math.cos(randomAngle) * S.teleportDistance, 50, math.sin(randomAngle) * S.teleportDistance))
					end
				end)
			end
		end))

		trackConn(RunService.Stepped:Connect(function()
			if not S.noclipOn then return end
			pcall(function()
				local char = player.Character
				if char then
					for _, part in ipairs(char:GetDescendants()) do
						if part:IsA("BasePart") and part.CanCollide then part.CanCollide = false end
					end
				end
			end)
		end))

