	local function handleInputBegan(input, gameProcessed)
		if input.UserInputType == Enum.UserInputType.Keyboard then
			if listeningKey then
				if input.KeyCode ~= Enum.KeyCode.Unknown then
					keybinds[listeningKey] = input.KeyCode
					local keyNameStr = tostring(input.KeyCode.Name)
					updateKeybindUI(listeningKey, keyNameStr)
					
					if listeningKey == "randomTp" then
						bindRandomTpBtn.Text = keyNameStr
						bindRandomTpBtn.TextColor3 = Color3.fromRGB(100, 200, 255)
					elseif listeningKey == "autoTp" then
						bindAutoTpBtn.Text = keyNameStr
						bindAutoTpBtn.TextColor3 = Color3.fromRGB(100, 200, 255)
					elseif listeningKey == "orbit" then
						bindOrbitBtn.Text = keyNameStr
						bindOrbitBtn.TextColor3 = Color3.fromRGB(100, 200, 255)
					elseif listeningKey == "fight" then
						bindFightBtn.Text = keyNameStr
						bindFightBtn.TextColor3 = Color3.fromRGB(100, 200, 255)
					elseif listeningKey == "noclip" then
						bindNoclipBtn.Text = keyNameStr
						bindNoclipBtn.TextColor3 = Color3.fromRGB(100, 200, 255)
					elseif listeningKey == "esp" then
						bindEspBtn.Text = keyNameStr
						bindEspBtn.TextColor3 = Color3.fromRGB(100, 200, 255)
					end
				end
				listeningKey = nil
			elseif not gameProcessed then
				if input.KeyCode == keybinds.randomTp then
					pcall(function()
						local _, myRoot = getSafeParts()
						if not myRoot then return end

						local validTargets = {}
						for _, p in ipairs(Players:GetPlayers()) do
							if p ~= player then
								local char = p.Character
								if char then
									local hum = char:FindFirstChildOfClass("Humanoid")
									local head = char:FindFirstChild("Head")
									if hum and hum.Health > 0 and head then
										table.insert(validTargets, head)
									end
								end
							end
						end

						if #validTargets > 0 then
							local randomHead = validTargets[math.random(1, #validTargets)]
							local randomAngle = math.random() * math.pi * 2
							local randomHeightOffset = (math.random() - 0.5) * 4
							local offsetDir = Vector3.new(math.cos(randomAngle), 0, math.sin(randomAngle))
							local targetCFrame = CFrame.new(randomHead.Position + (offsetDir * 5) + Vector3.new(0, randomHeightOffset, 0), randomHead.Position)
							myRoot.CFrame = targetCFrame
						end
					end)
				elseif input.KeyCode == keybinds.autoTp then
					teleporterOn = not teleporterOn
					setToggle(teleporterButton, teleporterOn, "auto 50k tp (every 0.1s)")
				elseif input.KeyCode == keybinds.orbit then
					orbitOn = not orbitOn
					if orbitOn then
						voidSpanOn = false
						setToggle(voidSpanButton, false, "void span mode")
					end
					setToggle(orbitButton, orbitOn, "orbit position mode")
				elseif input.KeyCode == keybinds.fight then
					if toggleFight then
						toggleFight(not fightOn)
					end
				elseif input.KeyCode == keybinds.noclip then
					if toggleNoclip then
						toggleNoclip(not noclipOn)
					end
				elseif input.KeyCode == keybinds.esp then
					if toggleEsp then
						toggleEsp(not espOn)
					end
				end
			end
		end
	end

