		triggerBotButton.MouseButton1Click:Connect(function() S.triggerBotOn = not S.triggerBotOn; setToggle(triggerBotButton, S.triggerBotOn, "trigger bot") end)
		wallbangButton.MouseButton1Click:Connect(function() S.wallbangOn = not S.wallbangOn; setToggle(wallbangButton, S.wallbangOn, "projectile wallbang") end)
		godModeButton.MouseButton1Click:Connect(function() S.godModeOn = not S.godModeOn; setToggle(godModeButton, S.godModeOn, "god mode") end)
		forceThirdPersonButton.MouseButton1Click:Connect(function() S.forceThirdPersonOn = not S.forceThirdPersonOn; setToggle(forceThirdPersonButton, S.forceThirdPersonOn, "force 3rd person (rivals)") end)

		rapidFireButton.MouseButton1Click:Connect(function()
