local function getSavedKey()
	if isfile and isfile(CONFIG_FILE_NAME) then
		local success, decoded = pcall(function()
			return game:GetService("HttpService"):JSONDecode(readfile(CONFIG_FILE_NAME))
		end)
		if success and type(decoded) == "table" then
			return decoded.verifiedKey
		end
	end
	return nil
end

local function saveVerifiedKey(key)
	if writefile then
		local success, encoded = pcall(function()
			return game:GetService("HttpService"):JSONEncode({ verifiedKey = key })
		end)
		if success then
			writefile(CONFIG_FILE_NAME, encoded)
		end
	end
end

