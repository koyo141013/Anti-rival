			espCache[p] = { Highlight = highlight, InfoBillboard = infoBillboard }
		end

		trackConn(RunService.RenderStepped:Connect(function()
			if not S.espOn and not S.namesOn and not S.healthOn then
				for p, _ in pairs(espCache) do removeEsp(p) end
				return
			end
			for _, p in ipairs(Players:GetPlayers()) do updateEspForPlayer(p) end
		end))

		trackConn(Players.PlayerRemoving:Connect(function(p) removeEsp(p) end))

		randomTpButton.MouseButton1Click:Connect(function()
			pcall(function()
				local _, myRoot = getSafeParts()
				if not myRoot then return end
				local validTargets = {}
				for _, p in ipairs(Players:GetPlayers()) do
					if p ~= player then
						local char = p.Character
						if char then
							local hum = char:FindFirstChildOfClass("Humanoid")
							local head = char:FindFirstChild("Head")
							if hum and hum.Health > 0 and head then table.insert(validTargets, head) end
						end
					end
				end
				if #validTargets > 0 then
					local randomHead = validTargets[math.random(1, #validTargets)]
					local randomAngle = math.random() * math.pi * 2
					local offsetDir = Vector3.new(math.cos(randomAngle), 0, math.sin(randomAngle))
					myRoot.CFrame = CFrame.new(randomHead.Position + (offsetDir * 5), randomHead.Position)
				end
			end)
		end)

		trackConn(RunService.RenderStepped:Connect(function()
			if not S.aimbotOn then return end
			pcall(function()
				local currentCam = getActiveCamera()
				local bestTarget = nil
				local shortestDist = math.huge

				local hasSelectedTarget = false
				for p, isSelected in pairs(selectedTargets) do
					if isSelected then
						hasSelectedTarget = true
						local char = p.Character
						if char then
							local hum = char:FindFirstChildOfClass("Humanoid")
							if hum and hum.Health > 0 then
								local targetPart = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
								if targetPart then
									local _, onScreen = currentCam:WorldToViewportPoint(targetPart.Position)
									if onScreen then
										local dist = (targetPart.Position - currentCam.CFrame.Position).Magnitude
										if dist < shortestDist then
											shortestDist = dist
											bestTarget = targetPart
										end
									end
								end
							end
						end
					end
				end

				if not bestTarget and not hasSelectedTarget then
					for _, p in ipairs(Players:GetPlayers()) do
						if p ~= player then
							local char = p.Character
							if char then
								local hum = char:FindFirstChildOfClass("Humanoid")
								if hum and hum.Health > 0 then
									local targetPart = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
									if targetPart then
										local _, onScreen = currentCam:WorldToViewportPoint(targetPart.Position)
										if onScreen then
											local dist = (targetPart.Position - currentCam.CFrame.Position).Magnitude
											if dist < shortestDist then
												shortestDist = dist
												bestTarget = targetPart
											end
										end
									end
								end
							end
						end
					end
				end

				if bestTarget then
					currentCam.CFrame = CFrame.new(currentCam.CFrame.Position, bestTarget.Position)
				end
			end)
		end))

		trackConn(RunService.RenderStepped:Connect(function()
			if not S.auraOn then return end
			pcall(function()
				local _, root = getSafeParts()
				if not root then return end
				for _, p in ipairs(Players:GetPlayers()) do
					if p ~= player then
						local char = p.Character
						if char then
							local hum = char:FindFirstChildOfClass("Humanoid")
							local targetRoot = char:FindFirstChild("HumanoidRootPart")
							if hum and hum.Health > 0 and targetRoot and (targetRoot.Position - root.Position).Magnitude <= 20 then
								for _, tool in ipairs(player.Character:GetChildren()) do
									if tool:IsA("Tool") then tool:Activate() end
								end
							end
						end
					end
				end
			end)
		end))

		local lastTriggerCheck = 0
		trackConn(RunService.RenderStepped:Connect(function()
			if not S.triggerBotOn then return end
			local now = os.clock()
			if now - lastTriggerCheck < 0.03 then return end
			lastTriggerCheck = now

			pcall(function()
				local char = player.Character
				if not char then return end
				local currentCam = getActiveCamera()
				if not currentCam then return end

				-- Ray from camera center (crosshair) - more reliable for FPS
				local unitRay = currentCam:ViewportPointToRay(currentCam.ViewportSize.X / 2, currentCam.ViewportSize.Y / 2)
				local raycastParams = RaycastParams.new()
				raycastParams.FilterType = Enum.RaycastFilterType.Exclude
				raycastParams.FilterDescendantsInstances = {char}
				raycastParams.IgnoreWater = true

				local raycastResult = Workspace:Raycast(unitRay.Origin, unitRay.Direction * 2000, raycastParams)
				if not raycastResult or not raycastResult.Instance then return end

				local hit = raycastResult.Instance
				local model = hit:FindFirstAncestorOfClass("Model") or hit.Parent
				if not model then return end

				local hum = model:FindFirstChildOfClass("Humanoid")
				local p = Players:GetPlayerFromCharacter(model)
				if hum and hum.Health > 0 and p and p ~= player then
					for _, tool in ipairs(char:GetChildren()) do
						if tool:IsA("Tool") then
							tool:Activate()
						end
					end
				end
			end)
		end))

		trackConn(RunService.Heartbeat:Connect(function()
			pcall(function()
				local char = player.Character
				local hum = char and char:FindFirstChildOfClass("Humanoid")
				
				if S.godModeOn and hum then
					hum.Health = hum.MaxHealth
				end

				if S.wallbangOn then
					for _, p in ipairs(Workspace:GetDescendants()) do
						if p:IsA("BasePart") and not p.Parent:FindFirstChildOfClass("Humanoid") then
							if p.CanCollide and p.Size.Magnitude < 50 then
								p.CanCollide = false
							end
						end
					end
				end
			end)
		end))

		trackConn(RunService.RenderStepped:Connect(function()
			if S.forceThirdPersonOn then
				pcall(function()
					player.CameraMode = Enum.CameraMode.Classic
