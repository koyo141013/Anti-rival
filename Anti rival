					healthText.Size = UDim2.new(1, 0, 0, 20)
					healthText.BackgroundTransparency = 1
					healthText.TextColor3 = Color3.fromRGB(100, 180, 255)
					healthText.TextSize, healthText.Font = 11, Enum.Font.Code
					healthText.TextStrokeTransparency = 0
					healthText.Parent = infoBillboard

					infoBillboard.Parent = head
				else
					infoBillboard.Adornee = head
				end

				local nameLabel = infoBillboard:FindFirstChild("NameText")
				local healthLabel = infoBillboard:FindFirstChild("HealthText")

				if nameLabel then nameLabel.Visible = namesOn; nameLabel.Text = p.Name end
				if healthLabel then
					healthLabel.Visible = (healthOn and hum ~= nil)
					if hum then healthLabel.Text = "HP: " .. math.floor(hum.Health) .. " / " .. math.floor(hum.MaxHealth) end
				end
			else
				if infoBillboard then infoBillboard:Destroy(); infoBillboard = nil end
			end

			espCache[p] = { Highlight = highlight, InfoBillboard = infoBillboard }
		end

		trackConn(RunService.RenderStepped:Connect(function()
			if not espOn and not namesOn and not healthOn then
				for p, _ in pairs(espCache) do removeEsp(p) end
				return
			end
			for _, p in ipairs(Players:GetPlayers()) do updateEspForPlayer(p) end
		end))

		trackConn(Players.PlayerRemoving:Connect(function(p) removeEsp(p) end))

		randomTpButton.MouseButton1Click:Connect(function()
			pcall(function()
				local _, myRoot = getSafeParts()
				if not myRoot then return end
				local validTargets = {}
				for _, p in ipairs(Players:GetPlayers()) do
					if p ~= player then
						local char = p.Character
						if char then
							local hum = char:FindFirstChildOfClass("Humanoid")
							local head = char:FindFirstChild("Head")
							if hum and hum.Health > 0 and head then table.insert(validTargets, head) end
						end
					end
				end
				if #validTargets > 0 then
					local randomHead = validTargets[math.random(1, #validTargets)]
					local randomAngle = math.random() * math.pi * 2
					local offsetDir = Vector3.new(math.cos(randomAngle), 0, math.sin(randomAngle))
					myRoot.CFrame = CFrame.new(randomHead.Position + (offsetDir * 5), randomHead.Position)
				end
			end)
		end)

		trackConn(RunService.RenderStepped:Connect(function()
			if not aimbotOn then return end
			pcall(function()
				local currentCam = getActiveCamera()
				local bestTarget = nil
				local shortestDist = math.huge
				for _, p in ipairs(Players:GetPlayers()) do
					if p ~= player then
						local char = p.Character
						if char then
							local hum = char:FindFirstChildOfClass("Humanoid")
							if hum and hum.Health > 0 then
								local targetPart = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
								if targetPart then
									local _, onScreen = currentCam:WorldToViewportPoint(targetPart.Position)
									if onScreen then
										local dist = (targetPart.Position - currentCam.CFrame.Position).Magnitude
										if dist < shortestDist then shortestDist = dist; bestTarget = targetPart end
									end
								end
							end
						end
					end
				end
				if bestTarget then currentCam.CFrame = CFrame.new(currentCam.CFrame.Position, bestTarget.Position) end
			end)
		end))

		trackConn(RunService.RenderStepped:Connect(function()
			if not auraOn then return end
			pcall(function()
				local _, root = getSafeParts()
				if not root then return end
				for _, p in ipairs(Players:GetPlayers()) do
					if p ~= player then
						local char = p.Character
						if char then
							local hum = char:FindFirstChildOfClass("Humanoid")
							local targetRoot = char:FindFirstChild("HumanoidRootPart")
							if hum and hum.Health > 0 and targetRoot and (targetRoot.Position - root.Position).Magnitude <= 45 then
								for _, tool in ipairs(player.Character:GetChildren()) do
									if tool:IsA("Tool") then tool:Activate() end
								end
							end
						end
					end
				end
			end)
		end))

		local lastTriggerCheck = 0
		trackConn(RunService.RenderStepped:Connect(function()
			if not triggerBotOn then return end
			local now = os.clock()
			if now - lastTriggerCheck < 0.05 then return end
			lastTriggerCheck = now

			pcall(function()
				local currentCam = getActiveCamera()
				local mouseLocation = UserInputService:GetMouseLocation()
				local unitRay = currentCam:ScreenPointToRay(mouseLocation.X, mouseLocation.Y)
				local raycastParams = RaycastParams.new()
				raycastParams.FilterType = RaycastType.Include
				local includeList = {}
				for _, p in ipairs(Players:GetPlayers()) do
					if p ~= player and p.Character then table.insert(includeList, p.Character) end
				end
				raycastParams.FilterDescendantsInstances = includeList
				local raycastResult = Workspace:Raycast(unitRay.Origin, unitRay.Direction * 10000, raycastParams)
				if raycastResult and raycastResult.Instance then
					local hitChar = raycastResult.Instance.Parent
					local hum = hitChar:FindFirstChildOfClass("Humanoid")
					local p = Players:GetPlayerFromCharacter(hitChar)
					if hum and hum.Health > 0 and p and p ~= player then
						for _, tool in ipairs(player.Character:GetChildren()) do
							if tool:IsA("Tool") then tool:Activate() end
						end
					end
				end
			end)
		end))

		trackConn(RunService.RenderStepped:Connect(function()
			if forceThirdPersonOn then
				pcall(function()
					player.CameraMode = Enum.CameraMode.Classic
					if player.CameraMinZoomDistance < 10 then player.CameraMinZoomDistance = 10 end
					local currentCam = getActiveCamera()
					if currentCam and currentCam.CameraType == Enum.CameraType.Scriptable then
						currentCam.CameraType = Enum.CameraType.Custom
					end
				end)
			end
		end))

		trackConn(RunService.RenderStepped:Connect(function()
			if orbitOn then
				pcall(function()
					local _, root = getSafeParts()
					if root then
						local t = os.clock() * 5
						root.CFrame = CFrame.new(root.Position + Vector3.new(math.cos(t) * 25, 10, math.sin(t) * 25))
					end
				end)
			elseif voidSpanOn then
				pcall(function()
					local _, root = getSafeParts()
					if root then root.CFrame = CFrame.new(root.Position + Vector3.new(0, 500, 0)) end
				end)
			end
		end))

		trackConn(RunService.RenderStepped:Connect(function()
			if not teleporterOn then return end
			local now = os.clock()
			if now - lastTeleportTick >= 0.1 then
				lastTeleportTick = now
				pcall(function()
					local _, root = getSafeParts()
					if root then
						local randomAngle = math.random() * math.pi * 2
						root.CFrame = CFrame.new(root.Position + Vector3.new(math.cos(randomAngle) * teleportDistance, 50, math.sin(randomAngle) * teleportDistance))
					end
				end)
			end
		end))

		trackConn(RunService.Stepped:Connect(function()
			if not noclipOn then return end
			pcall(function()
				local char = player.Character
				if char then
					for _, part in ipairs(char:GetDescendants()) do
						if part:IsA("BasePart") and part.CanCollide then part.CanCollide = false end
					end
				end
			end)
		end))

		walkButton.MouseButton1Click:Connect(function()
			walkOn = not walkOn
			setToggle(walkButton, walkOn, "walk speed")
			local h, _ = getSafeParts()
			if h then h.WalkSpeed = walkOn and walkSpeed or 16 end
		end)

		fightButton.MouseButton1Click:Connect(function() if toggleFight then toggleFight(not fightOn) end end)

		aimbotButton.MouseButton1Click:Connect(function() aimbotOn = not aimbotOn; setToggle(aimbotButton, aimbotOn, "aimbot") end)
		auraButton.MouseButton1Click:Connect(function() auraOn = not auraOn; setToggle(auraButton, auraOn, "aura") end)
		triggerBotButton.MouseButton1Click:Connect(function() triggerBotOn = not triggerBotOn; setToggle(triggerBotButton, triggerBotOn, "trigger bot") end)
		wallbangButton.MouseButton1Click:Connect(function() wallbangOn = not wallbangOn; setToggle(wallbangButton, wallbangOn, "projectile wallbang") end)
		godModeButton.MouseButton1Click:Connect(function() godModeOn = not godModeOn; setToggle(godModeButton, godModeOn, "god mode") end)
		forceThirdPersonButton.MouseButton1Click:Connect(function() forceThirdPersonOn = not forceThirdPersonOn; setToggle(forceThirdPersonButton, forceThirdPersonOn, "force 3rd person (rivals)") end)

		espButton.MouseButton1Click:Connect(function() if toggleEsp then toggleEsp(not espOn) end end)
		namesButton.MouseButton1Click:Connect(function() namesOn = not namesOn; setToggle(namesButton, namesOn, "player names") end)
		healthButton.MouseButton1Click:Connect(function() healthOn = not healthOn; setToggle(healthButton, healthOn, "player health text") end)

		fastShotButton.MouseButton1Click:Connect(function() fastShotOn = not fastShotOn; setToggle(fastShotButton, fastShotOn, "fast shot (Engine Bypass)") end)
		infiniteJumpButton.MouseButton1Click:Connect(function() infiniteJumpOn = not infiniteJumpOn; setToggle(infiniteJumpButton, infiniteJumpOn, "infinite jump") end)

		orbitButton.MouseButton1Click:Connect(function()
			orbitOn = not orbitOn
			if orbitOn then voidSpanOn = false; setToggle(voidSpanButton, false, "void span mode") end
			setToggle(orbitButton, orbitOn, "orbit position mode")
		end)

		voidSpanButton.MouseButton1Click:Connect(function()
			voidSpanOn = not voidSpanOn
			if voidSpanOn then orbitOn = false; setToggle(orbitButton, false, "orbit position mode") end
			setToggle(voidSpanButton, voidSpanOn, "void span mode")
		end)

		teleporterButton.MouseButton1Click:Connect(function() teleporterOn = not teleporterOn; setToggle(teleporterButton, teleporterOn, "auto 50k tp (every 0.1s)") end)
		noclipButton.MouseButton1Click:Connect(function() if toggleNoclip then toggleNoclip(not noclipOn) end end)

		showPage("main")
		print("Anti-rival beta v0.1.3.1 Loaded Successfully!")
	end)
end

